  "rules": [
    {
      "id": "G1",
      "kind": "grundsatz",
      "title": "Bedeckung vor Nutzung",
      "text": "Das Segment-Label beschreibt, was in der Draufsicht zu sehen ist (CLC+, FLAIR, LUCAS LC, EAGLE LCC). Nutzung, die das Bild nicht zeigt (Wiese vs. Weide, Kulturart, Brache-Status, Widmung), kommt in eine getrennte Attributschicht aus Fremddaten (INVEKOS, DKM) — EAGLE LUA, LUCAS LU, LISA LN (B6, B7, B11). Auch Siedlungsgrün ist keine Klasse: Rasen zählt zu Grünland (3.1), Gartenbaum, Strauch und Hecke zu Gehölz (4.2), Gartenbeet zu Acker (2.1/2.2). Ob ein Segment im Siedlungsgebiet liegt, trägt es als Merkmal `im_siedlung: ja|nein`; für Auswertungen nach Bericht 48 zählen Segmente der Klassen unter `bericht48.im_siedlung_klassen` mit `im_siedlung: ja` als `bericht48.im_siedlung_ziel` (Hausgärten „als Teil der Siedlung führen“, Bericht 48).",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:87 (Quellen: CLC+, FLAIR, LUCAS, EAGLE, LISA; Bericht 48); Entscheidung „Landschafts-Kategorien: Bedeckung statt Nutzung“ (2026-11-17)",
      "bericht48": {
        "im_siedlung_klassen": [
          "2",
          "3",
          "4.2"
        ],
        "im_siedlung_ziel": "1"
      }
    },
    {
      "id": "G2",
      "kind": "grundsatz",
      "title": "Sichtbare oberste Schicht",
      "text": "Baumkrone über Straße ist Baum; Verdecktes wird nicht geraten (wie Draufsicht-Schemata CLC+, FLAIR; vermutet für FLAIR, nicht in deren Regeln nachgelesen).",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:88 (Quellen: CLC+, FLAIR)"
    },
    {
      "id": "G3",
      "kind": "grundsatz",
      "title": "Keine harte Mindestfläche beim Segmentieren",
      "text": "Keine harte Mindestfläche beim Segmentieren (CLC+: „no MMU“); untere Grenze ist die Erkennbarkeit, Richtwert 3 Bildpunkte Breite (0,6 m bei 0,2 m; 1,5–3 m bei historischen 0,5–1 m) — Vorschlag, vermutet. Die Mindestgrößen aus Bericht 48 (100–400 m², Linien ≥ 2 m) und DKM (200 m²) sind Auswertungsebenen, die aus den feinen Segmenten aggregiert werden (deckt F1 „empfohlen“).",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:89 (Quellen: CLC+, Bericht 48, BANU-V); Entscheidung F1",
      "correction": "DKM-Mindestflächen nach § 4 BANU-V (Gegenprüfung B10, wuensche/2026-11-17-landseg-methode/gegenpruefung/e02.md:23): Gebäude ab 20 m², streifenförmige Elemente ab 4 m Breite (befestigte Verkehrswege und fließende Gewässer auch darunter), Wald ab 10 m Breite und 1 000 m², Alpen/Fels/Geröll/vegetationsarme Flächen/Gletscher ab 2 000 m², übrige Nutzungen ab 200 m². „DKM 200 m²“ gilt nur für die übrigen Nutzungen."
    },
    {
      "id": "G4",
      "kind": "grundsatz",
      "title": "Texturflächen statt Einzelreihen",
      "text": "Weingarten, Obstanlage, Acker mit Fahrspuren sind je eine Fläche (Zeilen nicht einzeln); Streuobst dagegen = Einzelbäume als eigene Segmente in Grünland, zusammengefasst über ein Verbund-Attribut „Streuobstbestand“ (Vorschlag).",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:90 (eigener Vorschlag)"
    },
    {
      "id": "G5",
      "kind": "grundsatz",
      "title": "Jede Klasse ist ein gültiges Label",
      "text": "Jede Klasse ist ein gültiges Label auf jeder Ebene (HILUCS-Prinzip „most appropriate and detailed level“, B13); das Trainingsziel kann so hierarchisch rechnen.",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:91 (Quelle: HILUCS, laut Gegenprüfung B13 unklar; gleichwertig ableitbar aus CLC+/LUCAS „most detailed class to be used“)"
    },
    {
      "id": "U1",
      "kind": "unklar",
      "title": "Feinste sichere Klasse, sonst Elternklasse",
      "text": "Feinste sicher entscheidbare Klasse; im Zweifel die Elternklasse (Ebene 2, notfalls Ebene 1) — Elternklassen sind gültige Labels (G5). Jedes Segment trägt dazu `sicher: ja|nein`.",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:169 (aus G5)"
    },
    {
      "id": "U2",
      "kind": "unklar",
      "title": "Schatten ist keine Klasse",
      "text": "Was im Schatten liegt, bekommt die Klasse der erkennbaren Fortsetzung (Straße läuft durch, Wiese setzt sich fort); geht das nicht, Elternklasse der Umgebung mit `sicher: nein`; Klasse 0.2 nur, wenn gar nichts erkennbar ist.",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:170 (eigener Vorschlag)"
    },
    {
      "id": "U3",
      "kind": "unklar",
      "title": "Mischpixel an Kanten",
      "text": "Grenze auf den Farb-/Helligkeitsumschlag (Stitcher-Einrasten, e05); ein Bildpunkt gehört der Klasse mit Mehrheit (CLC+: 50 %-Schwelle, B5).",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:171 (Quellen: CLC+, Stitcher-Einrasten e05)",
      "correction": "CLC+ nutzt keine schlichte Mehrheit, sondern eine 50 %-Schwelle mit Entscheidungsbaum und relativer Mehrheit; als Vorbild taugt es nur sinngemäß (Gegenprüfung B5, wuensche/2026-11-17-landseg-methode/gegenpruefung/e02.md:13)."
    },
    {
      "id": "U4",
      "kind": "unklar",
      "title": "Unter der Erkennbarkeitsgrenze",
      "text": "Unter Erkennbarkeitsgrenze (G3): Das Objekt fällt der umgebenden Klasse zu, nicht Klasse 0.",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:172 (aus G3)"
    },
    {
      "id": "U5",
      "kind": "unklar",
      "title": "Nutzung ist kein Grund für Unsicherheit",
      "text": "Ist nur die Nutzung unklar (Wiese oder Weide, Acker- oder Grünlandbrache), wird die Bedeckungsklasse der Ebene darüber genommen (3.1, 3.3) und die Nutzung bleibt Attribut `nutzung: unbekannt`, später aus INVEKOS/DKM füllbar.",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:173 (aus G1)"
    }
  ],
  "deviations": [
    {
      "id": "A1",
      "classes": [
        "0",
        "0.1",
        "0.2"
      ],
      "decisions": [
        "F2",
        "F5"
      ],
      "text": "Klasse 0 „Nicht bestimmbar“ kommt hinzu, nur für Bildfehler, Scanrand, Wolke; Lückenlosigkeit verlangt ein Label auch dort. In Auswertungen nach Bericht 48 wird 0 ausgeblendet (no data wie CLC+ 255).",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:163"
    },
    {
      "id": "A2",
      "classes": [
        "4",
        "4.2"
      ],
      "decisions": [
        "F1",
        "F2"
      ],
      "text": "Ebene 1 „Wald“ wird „Wald und Gehölze“: Hecken, Einzelbäume, Feldgehölze brauchen bei Lückenlosigkeit einen Platz in Ebene 1; ihr Bedeckungsbild ist das des Waldes (Krone). Für Bericht-48-Auswertungen gilt Wald = 4.1, Gehölze außerhalb Wald = 4.2 getrennt.",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:164"
    },
    {
      "id": "A3",
      "classes": [
        "1.3.1"
      ],
      "decisions": [
        "F5"
      ],
      "text": "Künstliche Schotterflächen (1.3.1) stehen unter „Versiegelt/bebaut“, obwohl nicht versiegelt (Nutzung Verkehr/Lager dominiert). Unbefestigte Wege stehen dagegen nach Bedeckung unter Offener Boden (6.6); das ersetzt für sie die Zuordnung „Verkehrsfläche“ aus F5.",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:165"
    },
    {
      "id": "A4",
      "classes": [
        "2.4",
        "2.4.1",
        "2.4.2",
        "2.4.3"
      ],
      "decisions": [
        "F5"
      ],
      "text": "Dauerkulturen (Weingarten, Obstanlage) stehen unter „Acker“ als 2.4; Bericht 48 führt Weingarten nur in Ebene 2. Streuobst ist keine eigene Fläche, sondern Einzelbäume (4.2.1) in Grünland (3.1) mit Verbund-Attribut (G4). Entschieden: Weingärten und Obstanlagen zählen zu Acker (F5).",
      "source": "wuensche/2026-11-17-landseg-methode/einheiten/e02.md:166"
    }
  ]
}
