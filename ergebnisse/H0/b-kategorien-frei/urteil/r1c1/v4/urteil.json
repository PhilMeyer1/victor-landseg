 "naht": [
  {
   "id": 400138,
   "seite": "rechts",
   "text": "Rest von 400138 reicht über den rechten und unteren Kernrand; die abgetrennten Innenteile berühren den Kernrand nicht, der Kontext blieb unverändert."
  },
  {
   "id": 400196,
   "seite": "unten",
   "text": "Rest von 400196 reicht über den unteren Kernrand (Rand des Ausschnitts)."
  },
  {
